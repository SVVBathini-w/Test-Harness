{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "testharness/test-inventory",
  "title": "Test inventory and regression classification",
  "description": "Governs the regression suite as a maintained quality asset rather than an accumulating pile of every test ever written. One entry per automated or manual test. Used to select regression, detect duplicate protection, and decide promotion, demotion and retirement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "generated_at",
    "tests"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "generated_at": {
      "type": "string",
      "minLength": 10,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}",
      "description": "ISO-8601. Date, or date-time. Length alone is not a date."
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test"
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional declared budget per tier, used to detect suite bloat, especially smoke growing into a mini full regression.",
      "properties": {
        "smoke_max": {
          "type": "integer",
          "minimum": 1
        },
        "smoke_max_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "critical_max_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "test_ref",
        "layer",
        "classification",
        "tier",
        "status",
        "automation_status"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 3,
          "description": "TC-<layer><nnn>, matching spec/cases.md."
        },
        "test_ref": {
          "type": "string",
          "minLength": 3,
          "description": "Project-relative path, with the test name where the file holds several."
        },
        "intent_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TI-[0-9]{3,}$"
          }
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "business_rule": {
          "type": "string"
        },
        "risk_protected": {
          "type": "string",
          "description": "What breaking behaviour this test would catch. An entry that cannot answer this is a retirement candidate."
        },
        "layer": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "classification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SMOKE",
              "CRITICAL_PATH_REGRESSION",
              "FUNCTIONAL_REGRESSION",
              "INTEGRATION_REGRESSION",
              "API_REGRESSION",
              "ACCESSIBILITY_REGRESSION",
              "SECURITY_REGRESSION",
              "PERFORMANCE_REGRESSION",
              "TARGETED_CHANGE_REGRESSION",
              "BROAD_REGRESSION",
              "FULL_REGRESSION",
              "RELEASE_CERTIFICATION",
              "QUARANTINED",
              "NON_REGRESSION",
              "RETIRED"
            ]
          },
          "description": "A test may hold several classifications when justified. NON_REGRESSION is a legitimate and common answer: not every test belongs in permanent regression."
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0 smoke, 1 critical business regression, 2 targeted change regression, 3 broad regression, 4 specialised. Tier 0 must answer yes to: if this fails, should downstream testing stop or be considered unreliable?"
        },
        "entry_justification": {
          "type": "string",
          "minLength": 15,
          "description": "Why this earned a place in permanent regression. Required in spirit for tier 0 and 1. Protects meaningful existing behaviour against likely or costly unintended change."
        },
        "entry_signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "CRITICAL_BUSINESS_WORKFLOW",
              "HIGH_USER_IMPACT",
              "PRODUCTION_ESCAPE",
              "CONFIRMED_REGRESSION",
              "DEFECT_PRONE_COMPONENT",
              "FREQUENT_CODE_CHANGE",
              "SHARED_COMPONENT",
              "HIGH_RISK_INTEGRATION",
              "AUTHORIZATION_BOUNDARY",
              "SECURITY_CONTROL",
              "FINANCIAL_CALCULATION",
              "DATA_INTEGRITY",
              "CONTRACTUAL_API",
              "CRITICAL_ACCESSIBILITY",
              "STATEFUL_FLOW",
              "CONCURRENCY",
              "HARD_TO_DETECT_FAILURE",
              "HIGH_RECURRENCE_PROBABILITY"
            ]
          }
        },
        "automation_status": {
          "enum": [
            "AUTOMATED",
            "MANUAL",
            "MANUAL_BY_NECESSITY",
            "AUTOMATION_PLANNED",
            "NOT_AUTOMATABLE"
          ]
        },
        "manual_reason": {
          "type": "string",
          "description": "Required when not automated. Requires screen reader verification is a reason. TODO is not."
        },
        "status": {
          "enum": [
            "HEALTHY",
            "UNSTABLE",
            "FLAKY",
            "QUARANTINED",
            "UNDER_REPAIR",
            "RETIRED"
          ],
          "description": "Reliability state. A regression test must be trustworthy to be worth running."
        },
        "quarantine": {
          "type": "object",
          "additionalProperties": false,
          "description": "Required when status is QUARANTINED. Quarantine does not mean ignore.",
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 10
            },
            "risk_now_uncovered": {
              "type": "string",
              "minLength": 10,
              "description": "What is no longer protected while this sits out."
            },
            "alternative_coverage": {
              "type": "string"
            },
            "remediation": {
              "type": "string"
            },
            "recovery_condition": {
              "type": "string"
            },
            "since": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}",
              "minLength": 10,
              "description": "ISO-8601. Date, or date-time. Length alone is not a date."
            }
          }
        },
        "reliability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runs": {
              "type": "integer",
              "minimum": 0
            },
            "failures": {
              "type": "integer",
              "minimum": 0
            },
            "flake_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "environment_sensitive": {
              "type": "boolean"
            },
            "data_sensitive": {
              "type": "boolean"
            },
            "last_executed": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}",
              "minLength": 10,
              "description": "ISO-8601. Date, or date-time. Length alone is not a date."
            },
            "last_result": {
              "enum": [
                "PASSED",
                "FAILED",
                "SKIPPED",
                "ERROR",
                "NOT_RUN"
              ]
            }
          }
        },
        "execution_cost_seconds": {
          "type": "number",
          "minimum": 0
        },
        "unique_detection_value": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "NONE",
            "UNMEASURED"
          ],
          "description": "Whether this test catches anything no other test catches. LOW or NONE with a high execution cost is a consolidation or retirement candidate."
        },
        "defects_detected": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Defect ids this test has actually caught. The strongest evidence of regression value there is."
        },
        "regression_for_defects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Defect ids this test exists to prevent recurring."
        },
        "lifecycle_decision": {
          "enum": [
            "KEEP",
            "PROMOTE",
            "DEMOTE",
            "CONSOLIDATE",
            "MOVE_TO_LOWER_LAYER",
            "REWRITE",
            "QUARANTINE",
            "RETIRE"
          ],
          "description": "Outcome of inventory review. Never retire useful regression merely to make the pipeline faster."
        },
        "lifecycle_rationale": {
          "type": "string"
        },
        "classification_history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "from",
              "to",
              "reason"
            ],
            "properties": {
              "at": {
                "type": "string",
                "minLength": 10,
                "pattern": "^\\d{4}-\\d{2}-\\d{2}",
                "description": "ISO-8601. Date, or date-time. Length alone is not a date."
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 10
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fixtures, seeded data, external services or other tests this depends on."
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^@[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": "Execution selectors carried in the test title, mirroring the intent tags."
        },
        "oracle_strength": {
          "enum": [
            "STRONG",
            "ADEQUATE",
            "WEAK",
            "MISSING"
          ],
          "description": "How well this test proves the intended business outcome. STRONG asserts the business rule directly. ADEQUATE asserts an observable consequence of it. WEAK executes the path but proves little - a presence check standing in for a value check. MISSING executes without asserting the outcome at all. A suite of WEAK oracles produces high pass rates and catches nothing, which is the failure mode that lets defects escape past a green run."
        },
        "oracle_note": {
          "type": "string",
          "description": "What the oracle actually asserts, and for WEAK or MISSING what it would take to strengthen it."
        },
        "debt": {
          "type": "array",
          "description": "Known QA debt carried by this test. Debt that is recorded can be prioritised; debt that is not is just decay.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "summary"
            ],
            "properties": {
              "type": {
                "enum": [
                  "FLAKY_TEST",
                  "OBSOLETE_TEST",
                  "DUPLICATE_TEST",
                  "MISSING_TRACEABILITY",
                  "WEAK_ORACLE",
                  "WRONG_TEST_LAYER",
                  "BRITTLE_AUTOMATION",
                  "MISSING_TEST_DATA",
                  "MISSING_REGRESSION",
                  "UNTESTABLE_COMPONENT",
                  "MISSING_OBSERVABILITY",
                  "STALE_KNOWLEDGE"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 10
              },
              "remediation": {
                "type": "string",
                "description": "The specific fix. \"Improve the test\" is not a remediation."
              },
              "severity": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "since": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}",
                "minLength": 10,
                "description": "ISO-8601. Date, or date-time. Length alone is not a date."
              }
            }
          }
        },
        "layers_verified": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "UI",
              "API",
              "DATABASE",
              "EVENT",
              "AUDIT_LOG",
              "EXTERNAL_SYSTEM",
              "METRIC",
              "TRACE"
            ]
          },
          "description": "Where this test establishes truth. A test asserting only UI for a workflow whose correctness depends on backend state cannot detect a silent failure."
        },
        "automation_tool": {
          "type": "string",
          "minLength": 1,
          "description": "The tool this test is implemented in, for example playwright, selenium, node:test, rest-assured, k6. Specification section 45. Several stacks may coexist deliberately (CLAUDE.md section 29), and without this the inventory cannot say which test belongs to which."
        },
        "language": {
          "enum": [
            "typescript",
            "javascript",
            "python",
            "csharp",
            "java",
            "kotlin",
            "go",
            "ruby",
            "php",
            "rust",
            "gherkin",
            "other"
          ],
          "description": "Implementation language of this test. Specification section 45."
        }
      }
    }
  }
}
