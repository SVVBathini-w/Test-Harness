{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "testharness/knowledge-record",
  "title": "Durable knowledge record",
  "description": "One curated fact worth carrying between sessions. Provenance is mandatory. Old inference is not permanent truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "subject",
    "statement",
    "quality",
    "confidence",
    "evidence",
    "verified_against",
    "last_verified",
    "scope"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^K-[a-z0-9-]+$"
    },
    "type": {
      "enum": [
        "interaction-pattern",
        "business-rule",
        "domain-term",
        "framework-convention",
        "testability-constraint",
        "defect-pattern",
        "flaky-pattern",
        "api-behaviour",
        "environment-fact",
        "qa-decision",
        "coverage-relation"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 2,
      "description": "Application, module, component, endpoint or page this concerns."
    },
    "statement": {
      "type": "string",
      "minLength": 15,
      "description": "The fact itself, stated so a future session can act on it without rediscovery."
    },
    "applies_when": {
      "type": "string",
      "description": "Conditions under which this pattern is valid. Prevents overreach."
    },
    "quality": {
      "enum": [
        "VERIFIED",
        "OBSERVED",
        "INFERRED",
        "ASSUMED",
        "STALE",
        "INVALIDATED"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "evidence": {
      "type": "string",
      "minLength": 10,
      "description": "How this was established. Command run, file inspected, DOM observed."
    },
    "verified_against": {
      "type": "object",
      "additionalProperties": false,
      "description": "The exact state this was true for. Staleness is detected by comparing against this.",
      "properties": {
        "source": {
          "type": "string",
          "description": "URL, repo path or file this was derived from."
        },
        "commit": {
          "type": "string"
        },
        "app_version": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        }
      }
    },
    "last_verified": {
      "type": "string",
      "minLength": 10,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}",
      "description": "ISO-8601. Date, or date-time. Length alone is not a date."
    },
    "scope": {
      "enum": [
        "EPHEMERAL",
        "SESSION",
        "PROJECT",
        "DURABLE"
      ]
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project slugs where this was observed."
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ids of related knowledge records."
    },
    "supersedes": {
      "type": "string",
      "description": "Id of the record this replaces. Update, never duplicate."
    }
  }
}
