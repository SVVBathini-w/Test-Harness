{
  "name": "testharness",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous QA harness. Projects live outside this repository (see CLAUDE.md section 11).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:cli": "node --test \"tests/cli/*.test.mjs\"",
    "test:hooks": "node --test \"tests/hooks/*.test.mjs\"",
    "test:conformance": "node --test \"tests/conformance/*.test.mjs\""
  }
}
