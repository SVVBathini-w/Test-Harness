# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every variable the suite reads belongs here with a placeholder value.

# Target
BASE_URL=https://example.test
API_BASE_URL=https://example.test/api

# Credentials — placeholders only, never real secrets in this file
TEST_USER=replace-me
TEST_PASSWORD=replace-me

# Execution
HEADLESS=true
WORKERS=4
TIMEOUT_MS=30000
RETRIES=0

# Test data
DATA_SEED=1

# The run folder is TH_RUN_DIR, set per execution by `qa-runs.mjs new`. It has no default and does not belong here.
