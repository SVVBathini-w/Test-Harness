{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-write-scope.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-artifact.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Workflow",
      "Bash(node bin/qa-plan.mjs:*)",
      "Bash(node bin/qa-state.mjs:*)",
      "Bash(node bin/qa-validate.mjs:*)",
      "Bash(npm test)",
      "Bash(node bin/qa-runs.mjs:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)"
    ]
  }
}
